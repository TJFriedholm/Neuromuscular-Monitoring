# Build settings that differ from ESP-IDF's defaults. `idf.py build` turns
# these into sdkconfig (not committed); edit here, not there.
# Based on Waveshare's 08_lvgl_demo_v9, without its demos and fonts.

# ---- Chip: ESP32-P4 silicon v3.2 (ADR-0007) ---------------------------------
CONFIG_IDF_TARGET="esp32p4"
# A build for rev < 3 does not boot on this unit.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# ---- Flash and PSRAM (32 MB each) -------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- FreeRTOS ---------------------------------------------------------------
# 1 ms scheduler tick, so vTaskDelay(1) is 1 ms rather than 10.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# ---- LVGL 9.5 (on the host this is sim/lv_conf.h; keep the two in step) -----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_TXT_BREAK_CHARS=" ,;:_)]}"
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
# To measure frame rate and render time again (ADR-0007), add
#   CONFIG_LV_USE_SYSMON=y
#   CONFIG_LV_USE_PERF_MONITOR=y
#   CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y
# and delete sdkconfig. It prints to the serial monitor every 300 ms. Its CPU
# figure is meaningless here: LVGL's idle measurement needs FreeRTOS task-switch
# hooks that ESP-IDF does not provide.

# ---- Logs -------------------------------------------------------------------
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
